use healthStatus, requestHealthAuthorization, healthStatistics, HealthStatus, HealthStatistics from "@exact/health"

shape Time
  epochAtZero: number
  utcOffset: number

shape DayBounds
  start: number
  end: number

component StepGarden
  state elapsed = 0
  state pedometerGoal = 10000 persist
  resource time = exactTime() as shape Time
  resource day = dayBounds(time.epochAtZero + elapsed) as shape DayBounds
  resource health = healthStatus(read=["steps"]) as shape HealthStatus else empty()
  resource steps = healthStatistics(type="steps", start=day.start, end=day.end, interval="P1D") as shape HealthStatistics else empty()
  mutation asked as shape HealthStatus then refreshToday
  derive total = match steps.buckets.at(0) { case some(bucket) => bucket.value, case none => none }
  derive hasAsked = health.state != "prompt"

  task clock mount
    every(60000, refreshToday)
  action refreshToday
    elapsed = performanceNow()
  action connect
    send asked = requestHealthAuthorization(read=["steps"])

  action changeGoal
    pedometerGoal = pedometerGoal == 10000 ? 5000 : 10000

  view
    main height="100%" background-color="#f1e9ff" color="#49316b"
      scroll flex=1 min-height=0
        column padding=26 gap=22
          row gap=12 align-items="center"
            column flex=1 gap=5
              text "Step Garden" font-size=35 font-weight=800 testId="title"
              text "A little movement. A little growth." font-size=14 color="#827096"
            image "symbol:sf/sun.max.fill" font-size=32 color="#b2c35a"
          text formatDate(time.epochAtZero + elapsed, time.utcOffset, "medium") font-size=14 color="#827096" testId="date"
          column padding=24 gap=16 align-items="center" background-color="#e0d4f3" border-radius=30
            if pending(health)
              image "assets/generated/pedometer/pedometer-hero-ef4690cb1922100cfd08e8aae8fe350504a3bc0f7d772e2aabe392e174721224.png" width=120 height=120 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="pedometer illustration" testId="hero"
              text "Checking Apple Health…" testId="health-loading"
            else if not health.available
              image "assets/generated/pedometer/pedometer-hero-ef4690cb1922100cfd08e8aae8fe350504a3bc0f7d772e2aabe392e174721224.png" width=120 height=120 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="pedometer illustration" testId="hero"
              text "Your garden is waiting" font-size=26 font-weight=700 testId="unavailable"
              text "Apple Health is unavailable here." font-size=14 color="#827096"
            else if not hasAsked
              image "assets/generated/pedometer/pedometer-hero-ef4690cb1922100cfd08e8aae8fe350504a3bc0f7d772e2aabe392e174721224.png" width=120 height=120 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="pedometer illustration" testId="hero"
              text "Give your steps a home" font-size=26 font-weight=700 testId="connect-title"
              text "Connect Apple Health to grow your garden." font-size=14 color="#827096"
            else if pending(steps)
              image "assets/generated/pedometer/pedometer-hero-ef4690cb1922100cfd08e8aae8fe350504a3bc0f7d772e2aabe392e174721224.png" width=120 height=120 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="pedometer illustration" testId="hero"
              text "Gathering today's steps…" testId="steps-loading"
            else if failed(steps)
              text "A little pause" font-size=26 font-weight=700 testId="read-error"
              text "Unlock your iPhone and try Refresh." font-size=14 color="#827096"
            else
              match total
                case some(count)
                  column align-items="center" gap=0 min-height=180 justify-content="end"
                    image "symbol:sf/leaf.fill" font-size=(36 + min(1, max(0, count / pedometerGoal)) * 60) color="#678a3d" testId="plant-leaf"
                    row width=7 height=(20 + min(1, max(0, count / pedometerGoal)) * 80) background-color="#678a3d" border-radius=5 testId="plant-stem"
                    row width=70 height=35 background-color="#d49c76" border-radius="4 4 20 20"
                  text `${round(count)}` font-size=64 font-weight=800 font-variant-numeric="tabular-nums" testId="steps"
                  text `of ${pedometerGoal} steps` font-size=17 color="#827096"
                case none
                  image "assets/generated/pedometer/pedometer-hero-ef4690cb1922100cfd08e8aae8fe350504a3bc0f7d772e2aabe392e174721224.png" width=120 height=120 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="pedometer illustration" testId="hero"
                  text "Room to grow" font-size=26 font-weight=700 testId="no-data"
                  text "No shared steps yet. Check Apple Health when you're ready." font-size=14 color="#827096"
          if health.available
            row gap=10
              button press=connect appearance="none" padding=16 min-height=54 background-color="#b9cc72" color="#344320" border-radius=27 flex=1 disabled=pending(asked) testId="connect"
                text (hasAsked ? "Health access" : "Connect Health") font-weight=700
              if hasAsked
                button press=refreshToday appearance="none" padding=16 min-height=54 background-color="#ffffff" color="#49316b" border-radius=27 disabled=pending(steps) testId="refresh"
                  text "Refresh"
          button press=changeGoal appearance="none" min-height=44 padding=12 color="#49316b" testId="goal"
            text `Your daily goal: ${pedometerGoal} · change`
          match failure(asked)
            case some(error)
              text "Couldn't open Health access. Please try again." color="#a74555" testId="authorization-error"
            case none
              text "" testId="authorization-error"
          text "Your real Apple Health steps, kept on this device. Empty data stays empty." font-size=12 color="#827096" testId="privacy-note"
