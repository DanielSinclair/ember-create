component SmallAdventures
  state weekendDay = "Saturday" persist
  state weekendCoffee = false persist
  state weekendWalk = false persist
  state weekendPicnic = false persist
  derive done = (weekendCoffee ? 1 : 0) + (weekendWalk ? 1 : 0) + (weekendPicnic ? 1 : 0)
  action day(value: string)
    weekendDay = value
  action coffee
    weekendCoffee = not weekendCoffee
  action walk
    weekendWalk = not weekendWalk
  action picnic
    weekendPicnic = not weekendPicnic
  action reset
    weekendCoffee = false
    weekendWalk = false
    weekendPicnic = false
  view
    main height="100%" background-color="#ffe58a" color="#1c385c"
      scroll flex=1 min-height=0
        column padding=26 gap=24
          row align-items="center"
            text "Small Adventures" font-size=38 font-weight=800 flex=1 testId="title"
            image "symbol:sf/sun.max.fill" font-size=60 color="#e28b3b"
          text "No grand plans required." font-size=20
          row gap=10
            for value in ["Saturday", "Sunday"] key=value
              button press=day(value) appearance="none" padding=16 min-height=52 flex=1 background-color=(weekendDay == value ? "#1c385c" : "#fff1bd") color=(weekendDay == value ? "#fff1bd" : "#1c385c") border-radius=26 testId=`day-${value}`
                text value font-weight=700
          row align-items="center" gap=16
            image "assets/generated/weekend/weekend-hero-ced1fdee7655c26d9030246137fe34c3646b2ac366dd587342c19d5dc81ffa66.png" width=128 height=128 object-fit="contain" background-color="#ffffff" border-radius=24 overflow="hidden" aria-label="weekend illustration" testId="hero"
            column flex=1 gap=4
              text weekendDay font-size=30 font-weight=800 testId="day"
              text `${done} of 3 little joys` testId="progress"
          column gap=12
            button press=coffee appearance="none" padding=18 min-height=64 background-color="#fff5d2" color="#1c385c" border-radius=18 testId="coffee"
              row gap=14
                image (weekendCoffee ? "symbol:sf/checkmark.circle.fill" : "symbol:sf/cup.and.saucer") font-size=25
                text "Find a good coffee" font-size=19
            button press=walk appearance="none" padding=18 min-height=64 background-color="#fff5d2" color="#1c385c" border-radius=18 testId="walk"
              row gap=14
                image (weekendWalk ? "symbol:sf/checkmark.circle.fill" : "symbol:sf/leaf") font-size=25
                text "Take the scenic way" font-size=19
            button press=picnic appearance="none" padding=18 min-height=64 background-color="#fff5d2" color="#1c385c" border-radius=18 testId="picnic"
              row gap=14
                image (weekendPicnic ? "symbol:sf/checkmark.circle.fill" : "symbol:sf/basket") font-size=25
                text "Pack a tiny picnic" font-size=19
          button press=reset appearance="none" padding=12 min-height=44 color="#49627a" testId="reset"
            text "Fresh plans"
