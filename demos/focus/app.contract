routes nav
  home "/"

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn mmss(ms: number): string = `${floor(ceil(ms / 1000) / 60)}:${pad2(ceil(ms / 1000) % 60)}`

component EditorialFocusTimerV2
  state minutes = 25
  state endsAt = 0
  state now = 0
  state remainingMs = 1500000
  state finished = false
  derive running = endsAt > 0
  derive left = running ? max(0, endsAt - now) : finished ? 0 : remainingMs
  derive startLabel = running ? "Pause" : finished ? "Start" : remainingMs < minutes * 60000 ? "Resume" : "Start"
  derive status = running ? "In session" : finished ? "Finished" : "Ready"
  task tick when running
    every(250, step)
  action step
    now = performanceNow()
    if performanceNow() >= endsAt
      endsAt = 0
      finished = true
      remainingMs = 0
  action toggle
    if running
      let leftNow = max(0, endsAt - performanceNow())
      now = performanceNow()
      remainingMs = leftNow
      endsAt = 0
    else
      let duration = finished or remainingMs <= 0 ? minutes * 60000 : remainingMs
      remainingMs = duration
      finished = false
      now = performanceNow()
      endsAt = performanceNow() + duration
  action resetTimer
    endsAt = 0
    finished = false
    remainingMs = minutes * 60000
    now = performanceNow()
  action choose(m: number)
    minutes = m
    endsAt = 0
    finished = false
    remainingMs = m * 60000
    now = performanceNow()
  view
    main height="100%" background-color="#f7f1e5" color="#2b2118" testId="app"
      scroll flex=1 min-height=0
        column padding=28 gap=28
          column gap=6
            text "Editorial Focus" font-size=34 font-weight=700
            text "A printed-journal timer" font-size=14 color="#7a6a58"
          row height=1 background-color="#2b2118"
          column gap=8 align-items="center" padding="12 0"
            text status font-size=13 color="#7a6a58" testId="status"
            text mmss(left) font-size=84 font-weight=700 font-variant-numeric="tabular-nums" testId="left"
            text `${minutes} minutes` font-size=14 color="#7a6a58" testId="duration"
          row height=1 background-color="#d9cfc0"
          column gap=14
            text "Interval" font-size=13 font-weight=700 color="#7a6a58"
            row gap=10
              button press=choose(5) appearance="none" background-color=(minutes == 5 ? "#2b2118" : "#efe6d6") color=(minutes == 5 ? "#f7f1e5" : "#2b2118") padding="12 16" min-height=44 border-radius=999 testId="min-5"
                text "5 min"
              button press=choose(15) appearance="none" background-color=(minutes == 15 ? "#2b2118" : "#efe6d6") color=(minutes == 15 ? "#f7f1e5" : "#2b2118") padding="12 16" min-height=44 border-radius=999 testId="min-15"
                text "15 min"
              button press=choose(25) appearance="none" background-color=(minutes == 25 ? "#2b2118" : "#efe6d6") color=(minutes == 25 ? "#f7f1e5" : "#2b2118") padding="12 16" min-height=44 border-radius=999 testId="min-25"
                text "25 min"
          row height=1 background-color="#d9cfc0"
          row gap=12
            button press=toggle appearance="none" background-color="#b0563a" color="#ffffff" padding="14 22" min-height=52 border-radius=999 flex=1 testId="start-pause"
              text startLabel font-size=17 font-weight=700
            button press=resetTimer appearance="none" background-color="#f7f1e5" color="#2b2118" padding="14 22" min-height=52 border-radius=999 testId="reset"
              text "Reset" font-size=17
          row height=1 background-color="#d9cfc0"
          text "Set an interval, begin, and let the page do the rest." font-size=14 color="#7a6a58"
