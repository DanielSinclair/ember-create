test "glasses add, undo, and survive relaunch"
  tap "add-water"
  tap "add-water"
  tap "undo"
  expect text "total" == "250"
  reload
  expect text "total" == "250"
  tap "reset"
  expect text "total" == "0"

test "the daily target can be changed"
  tap "goal"
  expect state hydrationGoal == 2500
