test "water accumulates in 250 mL increments"
  expect text "total" == "0 mL"
  tap "add-water"
  expect state total == 250
  expect text "total" == "250 mL"
  tap "add-water"
  expect state total == 500
  expect text "total" == "500 mL"

test "reset clears water and counting can restart"
  tap "reset"
  expect text "total" == "0 mL"
  tap "add-water"
  tap "add-water"
  tap "reset"
  expect state total == 0
  expect text "total" == "0 mL"
  tap "add-water"
  expect text "total" == "250 mL"
