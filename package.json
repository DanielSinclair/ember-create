{
  "name": "exact-create",
  "version": "0.1.0",
  "description": "Generate iOS apps with Muse Ember and run them in one Exact container.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielSinclair/ember-create.git"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "bin",
    "src",
    "demos",
    "patches",
    "tools/container.mjs",
    "tools/setup.sh",
    "tools/bootstrap.mjs",
    "tui/Cargo.toml",
    "tui/Cargo.lock",
    "tui/build.rs",
    "tui/run.sh",
    "tui/terminal.contract",
    "tui/src",
    "container/app.json",
    "container/package.json",
    "container/bun.lock",
    "container/exact.mjs",
    "container/strings",
    "container/assets/app-icon.png",
    ".env.example",
    "QUICKSTART.md",
    "CONTRIBUTING.md",
    "tools/testflight.mjs",
    "tools/demo-container.mjs",
    "DEMOS.md"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test ./tests",
    "serve": "bun src/cli.ts serve",
    "tui": "sh tui/run.sh"
  },
  "bin": {
    "exact-create": "bin/exact-create"
  }
}
