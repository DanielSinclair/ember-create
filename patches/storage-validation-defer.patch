+#[test]
+fn replacement_storage_is_deferred_then_reads_the_committed_directory() {
+    let root = Root::new();
+    std::fs::create_dir_all(root.0.join("data")).unwrap();
+    std::fs::write(root.0.join("data/kept"), "real device contents").unwrap();
+    let plan = contract::compile("shape Result\n  text: string\ncomponent App\n  resource saved = work(\"read-at\", \"kept\") as shape Result else empty()\n  view\n    text saved.text\n").unwrap();
+    let mut module = root.module();
+    module.activate_for_validation().unwrap();
+    let validation = Runner::boot(
+        plan.clone(),
+        module,
+        Kernel::with_monospace(),
+        Default::default(),
+        "/",
+    )
+    .unwrap();
+    assert!(validation.resource_reads_store("saved"));
+    assert_eq!(text(validation.resource("saved").unwrap().clone()), "");
+    let mut live = Runner::boot_carrying(
+        plan,
+        root.module(),
+        Kernel::with_monospace(),
+        &validation.carry(),
+        Default::default(),
+        "/",
+    )
+    .unwrap();
+    live.data().activate().unwrap();
+    live.data_ready().unwrap();
+    for _ in 0..100 {
+        if !live.has_pending() {
+            break;
+        }
+        for request in live.take_requests() {
+            let work = live
+                .data()
+                .continuation(request.request.continuation.unwrap())
+                .unwrap();
+            live.fulfill(request.ticket, std::thread::spawn(work).join().unwrap())
+                .unwrap();
+        }
+    }
+    assert!(!live.has_pending());
+    assert_eq!(
+        text(live.resource("saved").unwrap().clone()),
+        "real device contents"
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.0.join("data/kept")).unwrap(),
+        "real device contents"
+    );
+}
