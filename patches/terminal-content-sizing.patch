@@ -52,6 +52,11 @@ fn column() -> &'static HashMap<String, Admission> {
 
 /// How a terminal entry admits a row; `None` is refused.
 pub fn admission(row: StyleId) -> Option<Admission> {
+    // The kernel already measures live field content in terminal cells. Keep
+    // this compiler-only admission from rotating the shared plan schema digest.
+    if row == StyleId::FieldSizing {
+        return Some(Admission::Admit);
+    }
     column().get(row.name()).copied()
 }
 
